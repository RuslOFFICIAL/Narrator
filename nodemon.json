{
	"restartable": "rs",
	"stdin": false,
	"signal": "SIGTERM",
	"ignore": [
		"lores/",
		"sounds/",
		"node_modules/",
		"run.sh",
		"nodemon.json",
		"package-lock.json",
		"voice-state.json",
		".env.example"
	],
	"watch": [
		".",
		".env"
	],
	"ext": "js,json,env",
	"delay": 1,
	"exec": "node --dns-result-order=ipv4first narrator.js"
}
